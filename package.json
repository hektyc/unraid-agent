{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "unraid-mcp-server",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "unraid-mcp-server": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .cache",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "unraid",
    "unraid-mcp",
    "graphql",
    "server",
    "ai",
    "llm",
    "claude",
    "mcp-server"
  ],
  "description": "Feature-rich, safety-enhanced Unraid MCP server with read-only mode, granular action toggles, and universal AI client support",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "graphql-request": "^6.1.0",
    "graphql-ws": "^5.14.2",
    "ws": "^8.16.0",
    "zod": "^3.23.8",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "prettier": "^3.3.3"
  }
}
