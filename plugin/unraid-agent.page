<span style="font-weight:bold; color:#2ecc71; font-size:28px;">unRAID AGENT RUNNING</span>
<?php else: ?>
<span style="font-weight:bold; color:#e74c3c; font-size:28px;">unRAID AGENT STOPPED</span>
<?php endif; ?>
</div>
<?php endif; ?>

