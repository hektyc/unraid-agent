<?php
include "/usr/local/emhttp/plugins/unraid-agent/php/common.php";

// Handle Start/Stop actions in-page (no header() redirect — Unraid chrome
// output is already sent before this PHP runs). Run the script, let the
// daemon update the pid file, then fall through and render fresh status.
if (isset($_POST['agent_action'])) {
    $action = $_POST['agent_action'];
    $script = "/usr/local/emhttp/plugins/$plugin/scripts/$action.sh";
    if (($action === 'start' || $action === 'stop') && is_executable($script)) {
        exec("$script >/dev/null 2>&1 &");
        usleep(500000);
        if (file_exists($pidfile)) {
            $pid = trim(file_get_contents($pidfile));
            if ($pid !== '') {
                exec("kill -0 $pid 2>/dev/null", $output, $rc);
                $running = ($rc === 0);
            }
        } else {
            $running = false;
        }
    }
}

$transport   = $cfg('TRANSPORT', 'streamable-http');
$stdioMode   = ($transport === 'stdio');
$stdioEnable = ($cfg('UNRAID_MCP_ENABLE_STDIO', 'false') === 'true');
$mcpPort     = $cfg('UNRAID_MCP_PORT', '6970');

// Determine the MCP server URL for client configs:
// 1. UNRAID_MCP_ENDPOINT overrides everything (set this for reverse proxy setups)
// 2. Otherwise derive hostname + protocol from UNRAID_API_URL (the user's API URL)
// 3. Fall back to the WebGUI request host (how the browser is browsing the server)
$mcpEndpoint = $cfg('UNRAID_MCP_ENDPOINT');
$apiUrl   = $cfg('UNRAID_API_URL');
$serverHost = '';
$protocol  = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';

if (!empty($apiUrl)) {
    $parsed = parse_url($apiUrl);
    if (!empty($parsed['host'])) {
        $serverHost = $parsed['host'];
    }
    if (!empty($parsed['scheme'])) {
        $protocol = $parsed['scheme'];
    }
}
if ($serverHost === '') {
    if (!empty($_SERVER['HTTP_HOST'])) {
        $serverHost = preg_replace('/:\d+$/', '', $_SERVER['HTTP_HOST']);
    }
    if ($serverHost === '') {
        $serverHost = $_SERVER['SERVER_NAME'] ?? 'localhost';
    }
}

// Build the paste-ready client configuration snippet.
if ($stdioMode) {
    // Detect SSH port from var.ini (default 22); inject -p when non-default
    $sshPort = '22';
    $varIniPath = '/var/local/emhttp/var.ini';
    if (file_exists($varIniPath)) {
        $varsIni = @parse_ini_file($varIniPath, false, INI_SCANNER_RAW);
        if (is_array($varsIni) && !empty($varsIni['PORTSSH'])) {
            $sshPort = trim($varsIni['PORTSSH'], "\"' ");
        }
    }
    $sshCmd = ["ssh", "-T", "-o", "BatchMode=yes"];
    if ($sshPort !== '' && $sshPort !== '22') {
        $sshCmd[] = "-p";
        $sshCmd[] = $sshPort;
    }
    $sshCmd[] = "root@$serverHost";
    $sshCmd[] = "/usr/local/emhttp/plugins/unraid-agent/bin/unraid-agent";
    $sshCmd[] = "-config";
    $sshCmd[] = "/boot/config/plugins/unraid-agent/config.cfg";
    $sshCmd[] = "-transport";
    $sshCmd[] = "stdio";

    $clientConfig = json_encode([
        "mcp" => [
            "unraid-agent" => [
                "type"    => "local",
                "command" => $sshCmd,
                "enabled" => true
            ]
        ]
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
} else {
    $bearer = $cfg('UNRAID_MCP_BEARER_TOKEN');
    $authDisabled = ($cfg('UNRAID_MCP_DISABLE_HTTP_AUTH', 'false') === 'true');
    $mcpUrl = $mcpEndpoint !== ''
        ? $mcpEndpoint
        : "{$protocol}://{$serverHost}:{$mcpPort}/mcp";
    $server = [
        "type"    => "remote",
        "url"     => $mcpUrl,
        "enabled" => true
    ];
    if ($bearer !== '' && !$authDisabled) {
        $server["headers"] = ["Authorization" => "Bearer YOUR_BEARER_TOKEN"];
    }
    $clientConfig = json_encode([
        "mcp" => ["unraid-agent" => $server]
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
}
?>
