<script>
$(function() {
    var KEY = 'unraid-agent-perms-tab';
    function activate(t) {
        $('.ua-subtab').removeClass('active');
        $('.ua-pane').removeClass('active');
        $('.ua-subtab[data-tab="' + t + '"]').addClass('active');
        $('.ua-pane[data-tab="' + t + '"]').addClass('active');
    }
    var saved = localStorage.getItem(KEY);
    if (saved && $('.ua-subtab[data-tab="' + saved + '"]').length) {
        activate(saved);
    }
    $('.ua-subtab').on('click', function() {
        var t = $(this).data('tab');
        activate(t);
        localStorage.setItem(KEY, t);
    });
});
</script>
