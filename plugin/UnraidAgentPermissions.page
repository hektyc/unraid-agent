$stateDot = function($state) {
    $s = strtolower($state);
    if ($s === 'running') return '<span class="ua-dot" style="background:#2ecc71;" title="Running"></span>';
    if ($s === 'paused')  return '<span class="ua-dot" style="background:#e6a23c;" title="Paused"></span>';
    return '<span class="ua-dot" style="background:#95a5a6;" title="Stopped"></span>';
};

$chips = function($entityPerms, $actions) {
    $out = '';
    $has = false;
    foreach ($actions as $key => $label) {
        if (isset($entityPerms[$key])) {
            $has = true;
            $v = $entityPerms[$key];
            $color = $v === 'allow' ? '#2ecc71' : '#e74c3c';
            $mark  = $v === 'allow' ? '&#10003;' : '&#10007;';
            $out .= "<span class=\"ua-chip\" style=\"border-color:$color;color:$color;\" title=\"$label: $v\">" . substr($label, 0, 3) . " $mark</span>";
        }
    }
    if (!$has) {
        $out = '<span class="ua-chip ua-chip-global" title="All actions follow the global defaults">Global</span>';
    }
    return $out;
};
