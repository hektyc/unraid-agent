$tristate = function($key) use ($cfg) {
    $val = $cfg($key, 'domain');
    $opts = ['domain' => 'Default', 'true' => 'Yes', 'false' => 'No'];
    $html = "<select name=\"$key\" title=\"Default follows the domain master toggle\">";
    foreach ($opts as $v => $l) {
        $sel = ($val === $v) ? 'selected' : '';
        $html .= "<option value=\"$v\" $sel>$l</option>";
