<?php
include "/usr/local/emhttp/plugins/unraid-agent/php/common.php";

$yesno = function($key, $default = 'false') use ($cfg) {
    $val = $cfg($key, $default);
    $yes = ($val === 'true') ? 'selected' : '';
    $no  = ($val !== 'true') ? 'selected' : '';
    return "<select name=\"$key\"><option value=\"true\" $yes>Yes</option><option value=\"false\" $no>No</option></select>";
};

// Renders one sub-tab panel: a self-contained form posting only this
// section's fields (core update.php merges into config.cfg).
$panel = function($id, $active, $fieldsHtml) use ($plugin, $var) {
    $cls = $active ? 'ua-pane active' : 'ua-pane';
    return "<div class=\"$cls\" data-tab=\"$id\">
<form markdown=\"1\" method=\"POST\" action=\"/update.php\" target=\"progressFrame\">
<input type=\"hidden\" name=\"csrf_token\" value=\"{$var['csrf_token']}\">
<input type=\"hidden\" name=\"#file\" value=\"$plugin/config.cfg\">
<input type=\"hidden\" name=\"#command\" value=\"/usr/local/emhttp/plugins/$plugin/scripts/apply.sh\">
$fieldsHtml
<div style=\"text-align:center;margin-top:18px;\">
<input type=\"submit\" name=\"#default\" value=\"Default\">
<input type=\"submit\" name=\"#apply\" value=\"Apply\">
<input type=\"button\" value=\"Done\" onclick=\"done()\">
</div>
</form>
</div>";
};

$field = function($label, $selectHtml, $help = '') {
    $h = $help ? "<blockquote class=\"inline_help\">$help</blockquote>" : '';
    return "_($label)_:\n: $selectHtml\n$h\n";
};
