      <button class="ua-btn" id="ua-modal-clear">Clear Overrides</button>
      <button class="ua-btn" id="ua-modal-cancel">Cancel</button>
      <button class="ua-btn ua-btn-primary" id="ua-modal-save">Save</button>
    </div>
  </div>
</div>

<script>
$(function() {
    var KEY = 'unraid-agent-perms-tab';
    var TGKEY = 'unraid-agent-toolset-tab';
    function activate(t) {
        $('.ua-subtab:not([data-tab^="tg-"])').removeClass('active');
        $('.ua-pane[data-tab]:not([data-tab^="tg-"])').removeClass('active');
        $('.ua-subtab[data-tab="' + t + '"]').addClass('active');
        $('.ua-pane[data-tab="' + t + '"]').addClass('active');
        if (t === 'tools') { ensureTg(); }
    }
    function activateTg(t) {
        $('.ua-subtab[data-tab^="tg-"]').removeClass('active');
        $('.ua-pane[data-tab^="tg-"]').removeClass('active');
        $('.ua-subtab[data-tab="' + t + '"]').addClass('active');
        $('.ua-pane[data-tab="' + t + '"]').addClass('active');
    }
    function ensureTg() {
        var saved = localStorage.getItem(TGKEY);
        if (!saved || !$('.ua-subtab[data-tab="' + saved + '"]').length) { saved = 'tg-core'; }
        activateTg(saved);
    }
    var saved = localStorage.getItem(KEY);
    if (saved && $('.ua-subtab[data-tab="' + saved + '"]').length) {
        activate(saved);
    }
    // Guarantee Master Switch shows if no pane ended up active
    if (!$('.ua-pane.active').length) {
        activate('master');
    }
    $('.ua-subtab:not([data-tab^="tg-"])').on('click', function() {
        var t = $(this).data('tab');
        activate(t);
        localStorage.setItem(KEY, t);
    });
    $('.ua-subtab[data-tab^="tg-"]').on('click', function() {
        var t = $(this).data('tab');
        activateTg(t);
        localStorage.setItem(TGKEY, t);
    });

    // Expand/collapse tool domains
    $(document).on('click', '.ua-domain-head', function() {
        var tools = $(this).next('.ua-domain-tools');
        tools.toggle();
        $(this).find('.ua-domain-caret').text(tools.is(':visible') ? '▾' : '▸');
    });

    var ACTIONS = {
        containers: [['start','Start'],['stop','Stop'],['restart','Restart'],['pause','Pause'],['unpause','Unpause'],['remove','Remove'],['update','Update']],
        vms: [['start','Start'],['stop','Stop'],['pause','Pause'],['resume','Resume'],['force_stop','Force Stop'],['reboot','Reboot'],['reset','Reset']],
        plugins: [['remove','Remove']]
    };
    var SELF_PROTECTED = 'unraid-agent';
    var cur = null;

    function openModal(card) {
        var entity = card.data('entity');
        if (!entity) { return; } // never open an empty modal
        cur = {
            type: card.data('type'),
            entity: entity,
            icon: card.data('icon'),
            perms: card.data('perms') || {}
        };
        var isSelf = (cur.type === 'plugins' && cur.entity === SELF_PROTECTED);
        $('#ua-modal-name').text(cur.entity);
        $('#ua-modal-icon').html(cur.icon
            ? '<img src="' + cur.icon + '" style="width:44px;height:44px;object-fit:contain;">'
            : '<i class="fa ' + (cur.type === 'vms' ? 'fa-desktop' : (cur.type === 'plugins' ? 'fa-plug' : 'fa-cubes')) + '" style="font-size:40px;color:' + (cur.type === 'vms' ? '#9b59b6' : (cur.type === 'plugins' ? '#2ecc71' : '#0db7ed')) + ';"></i>');

        if (isSelf) {
            $('#ua-modal-rows').html(
                '<div style="padding:12px 4px;line-height:1.6;">' +
                '<b>Protected plugin.</b><br>' +
                'unraid-agent can never be removed through the MCP server — that would shut down ' +
                'this very channel. If removal is ever intended, use the Unraid WebGUI Plugins page.' +
                '</div>');
            $('#ua-modal-save').hide();
            $('#ua-modal-clear').hide();
        } else {
            var rows = '';
            $.each(ACTIONS[cur.type], function(i, pair) {
                var action = pair[0], label = pair[1];
                var val = cur.perms[action] || 'inherit';
                rows += '<div class="ua-perm-row"><div class="ua-perm-pair">' +
                    '<span class="ua-perm-label">' + label + '</span>' +
                    '<select class="ua-perm-select" data-action="' + action + '">' +
                    '<option value="inherit"' + (val === 'inherit' ? ' selected' : '') + '>Use Global</option>' +
                    '<option value="allow"' + (val === 'allow' ? ' selected' : '') + '>Allow</option>' +
                    '<option value="deny"' + (val === 'deny' ? ' selected' : '') + '>Deny</option>' +
                    '</select></div></div>';
            });
            $('#ua-modal-rows').html(rows);
            $('#ua-modal-save').show();
            $('#ua-modal-clear').show();
        }
        $('#ua-modal-err').text('');
        $('#ua-modal').fadeIn(120);
    }

    function closeModal() { $('#ua-modal').fadeOut(120); cur = null; }

    function collectPerms(allInherit) {
        var perms = {};
        $('.ua-perm-select').each(function() {
            perms[$(this).data('action')] = allInherit ? 'inherit' : $(this).val();
        });
        return perms;
    }

    function save(allInherit) {
        if (!cur) return;
        $('#ua-modal-err').text('Saving…');
        $.ajax({
            url: '/plugins/unraid-agent/php/save-perms.php',
            method: 'POST',
            data: {
                csrf_token: '<?=$var['csrf_token']?>',
                entity_type: cur.type,
                entity: cur.entity,
                perms: JSON.stringify(collectPerms(allInherit))
            },
            success: function(resp) {
                if (resp && resp.ok) {
                    location.reload();
                } else {
                    $('#ua-modal-err').text((resp && resp.error) ? resp.error : 'Save failed');
                }
            },
            error: function(xhr) {
                var msg = 'Save failed (' + xhr.status + ')';
                try { var r = JSON.parse(xhr.responseText); if (r.error) msg = r.error; } catch(e) {}
                $('#ua-modal-err').text(msg);
            }
        });
    }

    $(document).on('click', '.ua-card', function(e) {
        var card = $(this);
        if (!card.data('entity')) { return; } // ignore clicks that carry no entity data
        e.stopPropagation();
        openModal(card);
    });
    $('#ua-modal-cancel').on('click', closeModal);
    $('#ua-modal-save').on('click', function() { save(false); });
    $('#ua-modal-clear').on('click', function() { save(true); });
    $('#ua-modal').on('click', function(e) { if (e.target === this) closeModal(); });
});
</script>
