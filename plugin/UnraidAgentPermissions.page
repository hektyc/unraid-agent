$yesno = function($key, $default = 'false') use ($cfg) {
    $val = $cfg($key, $default);
    $yes = ($val === 'true') ? 'selected' : '';
    $no  = ($val !== 'true') ? 'selected' : '';
    return "<select name=\"$key\"><option value=\"true\" $yes>Yes</option><option value=\"false\" $no>No</option></select>";
};
