<?php
include "/usr/local/emhttp/plugins/unraid-agent/php/common.php";

$yesno = function($key, $default = 'false') use ($cfg) {
    $val = $cfg($key, $default);
    $yes = ($val === 'true') ? 'selected' : '';
    $no  = ($val !== 'true') ? 'selected' : '';
    return "<select name=\"$key\"><option value=\"true\" $yes>Yes</option><option value=\"false\" $no>No</option></select>";
};

// Form wrappers (the markdown fields stay literal; wrappers emit plain HTML).
$formOpen = function() use ($plugin, $var) {
    echo "<form markdown=\"1\" method=\"POST\" action=\"/update.php\" target=\"progressFrame\">\n";
    echo "<input type=\"hidden\" name=\"csrf_token\" value=\"{$var['csrf_token']}\">\n";
    echo "<input type=\"hidden\" name=\"#file\" value=\"$plugin/config.cfg\">\n";
    echo "<input type=\"hidden\" name=\"#command\" value=\"/usr/local/emhttp/plugins/$plugin/scripts/apply.sh\">\n";
};
$formClose = function() {
    echo "<div style=\"text-align:center;margin-top:18px;\">\n";
    echo "<input type=\"submit\" name=\"#default\" value=\"Default\">\n";
    echo "<input type=\"submit\" name=\"#apply\" value=\"Apply\">\n";
    echo "<input type=\"button\" value=\"Done\" onclick=\"done()\">\n";
    echo "</div>\n</form>\n";
};

$perms = ua_load_perms();
$containers = ua_list_containers();
$vms = ua_list_vms();

$containerActions = [
    'start' => 'Start', 'stop' => 'Stop', 'restart' => 'Restart',
    'pause' => 'Pause', 'unpause' => 'Unpause', 'remove' => 'Remove', 'update' => 'Update',
];
$vmActions = [
    'start' => 'Start', 'stop' => 'Stop', 'pause' => 'Pause', 'resume' => 'Resume',
    'force_stop' => 'Force Stop', 'reboot' => 'Reboot', 'reset' => 'Reset',
];

$stateDot = function($state) {
    $s = strtolower($state);
    if ($s === 'running') return '<span class="ua-dot" style="background:#2ecc71;" title="Running"></span>';
    if ($s === 'paused')  return '<span class="ua-dot" style="background:#e6a23c;" title="Paused"></span>';
    return '<span class="ua-dot" style="background:#95a5a6;" title="Stopped"></span>';
};

$chips = function($entityPerms, $actions) {
    $out = '';
    $has = false;
    foreach ($actions as $key => $label) {
        if (isset($entityPerms[$key])) {
            $has = true;
            $v = $entityPerms[$key];
            $color = $v === 'allow' ? '#2ecc71' : '#e74c3c';
            $mark  = $v === 'allow' ? '&#10003;' : '&#10007;';
            $out .= "<span class=\"ua-chip\" style=\"border-color:$color;color:$color;\" title=\"$label: $v\">" . substr($label, 0, 3) . " $mark</span>";
        }
    }
    if (!$has) {
        $out = '<span class="ua-chip ua-chip-global" title="All actions follow the global defaults">Global</span>';
    }
    return $out;
};
