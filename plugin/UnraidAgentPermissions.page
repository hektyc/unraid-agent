$yesno = function($key, $default = 'false') use ($cfg) {
    $val = $cfg($key, $default);
    $yes = ($val === 'true') ? 'selected' : '';
    $no  = ($val !== 'true') ? 'selected' : '';
    return "<select name=\"$key\"><option value=\"true\" $yes>Yes</option><option value=\"false\" $no>No</option></select>";
};

// Form wrappers (the markdown fields stay literal; wrappers emit plain HTML).
$formOpen = function() use ($plugin, $var) {
    echo "<form method=\"POST\" action=\"/update.php\" target=\"progressFrame\">\n";
    echo "<input type=\"hidden\" name=\"csrf_token\" value=\"{$var['csrf_token']}\">\n";
    echo "<input type=\"hidden\" name=\"#file\" value=\"$plugin/config.cfg\">\n";
    echo "<input type=\"hidden\" name=\"#command\" value=\"/usr/local/emhttp/plugins/$plugin/scripts/apply.sh\">\n";
};
$formClose = function() {
    echo "<div style=\"text-align:center;margin-top:18px;\">\n";
    echo "<input type=\"submit\" name=\"#default\" value=\"Default\">\n";
    echo "<input type=\"submit\" name=\"#apply\" value=\"Apply\">\n";
    echo "<input type=\"button\" value=\"Done\" onclick=\"done()\">\n";
