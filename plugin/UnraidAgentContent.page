<blockquote class="inline_help">
Facts and notes agents can read via memory_list/memory_get. Each connected client gets
its own scope; the defaults scope holds the auto-generated server profile. Writes from
agents require Allow Memory Write in Permissions → System.
</blockquote>

<div class="ac-toolbar"><button type="button" class="ac-btn-new" id="ac-new-memory">+ New Memory</button></div>

<?php foreach ($memoryByScope as $scope => $entries): ?>
<div class="ac-scope">
  <div class="ac-scope-title"><i class="fa fa-database" style="color:#4a90d9;"></i> <?=htmlspecialchars($scope)?></div>
  <div class="ua-grid">
  <?php foreach ($entries as $m): ?>
    <div class="ua-card ac-memory-card" data-scope="<?=htmlspecialchars($scope)?>" data-name="<?=htmlspecialchars($m['name'])?>" data-file="<?=htmlspecialchars($m['file'])?>">
      <div class="ua-card-top">
        <i class="fa fa-sticky-note ua-card-icon-fa" style="color:#4a90d9;"></i>
        <span class="ua-dot" style="background:#4a90d9;"></span>
      </div>
      <div class="ua-card-name"><?=htmlspecialchars($m['name'])?></div>
      <div class="ua-card-status"><?=$m['mtime'] ? date('Y-m-d H:i', $m['mtime']) : ''?></div>
      <div class="ua-card-chips">
        <span class="ua-chip ua-chip-global"><?=htmlspecialchars($scope)?></span>
        <span class="ua-chip ua-chip-global ac-export" data-kind="memory" data-name="<?=htmlspecialchars($m['name'])?>" data-scope="<?=htmlspecialchars($scope)?>" title="Download as markdown">Export</span>
      </div>
    </div>
  <?php endforeach; ?>
  </div>
</div>
<?php endforeach; ?>
<?php if (empty($memoryByScope)): ?>
  <p><em>No memory entries yet — the server profile is generated on first daemon start, and agents can write their own once Allow Memory Write is enabled.</em></p>
<?php endif; ?>
</div>

<div class="ua-modal-overlay" id="ac-modal" style="display:none;">
  <div class="ac-modal ua-modal" style="width:720px;">
    <div class="ua-modal-head">
      <i class="fa fa-graduation-cap" style="font-size:34px;color:#ff8c2f;" id="ac-modal-icon"></i>
      <span class="ua-modal-name" id="ac-modal-title">Edit</span>
    </div>
    <div class="ac-field" id="ac-field-name">
      <label>Name (lowercase letters, digits, hyphens)</label>
      <input type="text" class="ac-name-input" id="ac-name">
    </div>
    <div class="ac-field" id="ac-field-desc">
      <label>Description (what it does and when to use it — the trigger text)</label>
      <input type="text" class="ac-desc-input" id="ac-desc">
    </div>
    <div class="ac-field">
      <label>Content (Markdown)</label>
      <textarea id="ac-content" rows="16"></textarea>
    </div>
    <div class="ua-modal-err" id="ac-err"></div>
    <div class="ua-modal-foot">
      <button type="button" class="ua-btn" id="ac-delete" style="border-color:#e74c3c;color:#e74c3c;">Delete</button>
      <button type="button" class="ua-btn" id="ac-cancel">Cancel</button>
      <button type="button" class="ua-btn ua-btn-primary" id="ac-save">Save</button>
    </div>
  </div>
</div>

<script>
$(function() {
    var KEY = 'unraid-agent-content-tab';
    function activate(t) {
        $('.ua-subtab').removeClass('active');
        $('.ac-pane[data-tab]').removeClass('active');
        $('.ua-subtab[data-tab="' + t + '"]').addClass('active');
        $('.ac-pane[data-tab="' + t + '"]').addClass('active');
    }
    var saved = localStorage.getItem(KEY);
    // Always activate a valid sub-tab on load — never land on a blank canvas
    var target = (saved && $('.ua-subtab[data-tab="' + saved + '"]').length) ? saved : 'skills';
    activate(target);
    $('.ua-subtab').on('click', function() {
        var t = $(this).data('tab');
        activate(t);
        localStorage.setItem(KEY, t);
    });

    var cur = null;

    function openModal(kind, data) {
        cur = { kind: kind, data: data };
        var isSkill = (kind === 'skill');
        $('#ac-modal-title').text(data.title || (isSkill ? 'Edit Skill' : 'Edit Memory'));
        $('#ac-modal-icon').attr('class', 'fa ' + (isSkill ? 'fa-graduation-cap' : 'fa-sticky-note'))
            .css({fontSize: '34px', color: isSkill ? '#ff8c2f' : '#4a90d9'});
        $('#ac-name').val(data.name || '').prop('disabled', !data.isNew && !isSkill);
        $('#ac-desc').val(data.description || '');
        $('#ac-field-desc').toggle(isSkill);
        $('#ac-field-name label').text(isSkill
            ? 'Name (lowercase letters, digits, hyphens)'
            : 'Name (lowercase letters, digits, hyphens) — scope: ' + (data.scope || 'default'));
        $('#ac-content').val(data.content || '');
        $('#ac-delete').toggle(!data.isNew && (isSkill ? data.source === 'custom' : true));
        $('#ac-err').text('');
        $('#ac-modal').fadeIn(120);
    }
    function closeModal() { $('#ac-modal').fadeOut(120); cur = null; }

    function loadFile(file, cb) {
        $.post('/plugins/unraid-agent/php/read-content.php', {csrf_token: '<?=$var['csrf_token']?>', file: file}, function(resp) {
            cb(resp && resp.ok ? resp.content : '', null);
        }, 'json').fail(function(xhr) {
            var msg = '// Failed to load content (HTTP ' + xhr.status + ')';
            try { var r = JSON.parse(xhr.responseText); if (r.error) msg += ' — ' + r.error; } catch(e) {}
            cb(msg, msg);
        });
    }

    $(document).on('click', '.ac-skill-card', function(e) {
        if ($(e.target).hasClass('ac-export')) return;
        var card = $(this);
        loadFile(card.data('file'), function(content) {
            openModal('skill', {name: card.data('name'), source: card.data('source'), file: card.data('file'), content: content, isNew: false});
        });
    });
    $(document).on('click', '.ac-memory-card', function(e) {
        if ($(e.target).hasClass('ac-export')) return;
        var card = $(this);
        loadFile(card.data('file'), function(content) {
            openModal('memory', {name: card.data('name'), scope: card.data('scope'), file: card.data('file'), content: content, isNew: false});
        });
    });
    $(document).on('click', '.ac-export', function(e) {
        e.stopPropagation();
        var el = $(this);
        var kind = el.data('kind') || 'skill';
        var url = '/plugins/unraid-agent/php/export-content.php?kind=' + encodeURIComponent(kind) + '&name=' + encodeURIComponent(el.data('name'));
        if (kind === 'skill') {
            url += '&source=' + encodeURIComponent(el.data('source'));
        } else {
            url += '&scope=' + encodeURIComponent(el.data('scope'));
        }
        window.location = url;
    });
    $('#ac-new-skill').on('click', function() { openModal('skill', {isNew: true, source: 'custom', title: 'New Skill'}); });
    $('#ac-new-memory').on('click', function() { openModal('memory', {isNew: true, scope: 'custom', title: 'New Memory'}); });

    $('#ac-save').on('click', function(e) {
        e.preventDefault();
        if (!cur) return;
        var isSkill = (cur.kind === 'skill');
        var payload = {
            csrf_token: '<?=$var['csrf_token']?>',
            name: $('#ac-name').val(),
            content: $('#ac-content').val()
        };
        if (isSkill) payload.description = $('#ac-desc').val();
        if (!isSkill) payload.scope = cur.data.scope || 'custom';
        $('#ac-err').text('Saving…');
        $.post('/plugins/unraid-agent/php/save-content.php', $.extend(payload, {kind: cur.kind}), function(resp) {
            if (resp && resp.ok) { location.replace(location.href); }
            else { $('#ac-err').text((resp && resp.error) ? resp.error : 'Save failed'); }
        }, 'json').fail(function(xhr) {
            var msg = 'Save failed (' + xhr.status + ')';
            try { var r = JSON.parse(xhr.responseText); if (r.error) msg = r.error; } catch(e) {}
            $('#ac-err').text(msg);
        });
    });
    $('#ac-delete').on('click', function(e) {
        e.preventDefault();
        if (!cur || !cur.data || !cur.data.file) return;
        if (!confirm('Delete this entry?')) return;
        $('#ac-err').text('Deleting…');
        $.post('/plugins/unraid-agent/php/save-content.php', {
            csrf_token: '<?=$var['csrf_token']?>',
            kind: cur.kind,
            action: 'delete',
            file: cur.data.file
        }, function(resp) {
            if (resp && resp.ok) { location.replace(location.href); }
            else { $('#ac-err').text((resp && resp.error) ? resp.error : 'Delete failed'); }
        }, 'json').fail(function(xhr) {
            var msg = 'Delete failed (' + xhr.status + ')';
            try { var r = JSON.parse(xhr.responseText); if (r.error) msg = r.error; } catch(e) {}
            $('#ac-err').text(msg);
        });
    });
    $('#ac-cancel').on('click', function(e) { e.preventDefault(); closeModal(); });
    $('#ac-modal').on('click', function(e) { if (e.target === this) closeModal(); });
});
</script>
