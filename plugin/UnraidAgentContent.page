<?php
include "/usr/local/emhttp/plugins/unraid-agent/php/common.php";

$skillsBase = "/boot/config/plugins/$plugin/skills";
$memoryBase = "/boot/config/plugins/$plugin/memory";

// Read skills from defaults + custom dirs (flash is ground truth; the daemon
// syncs the embedded pack into defaults/ at startup)
$ua_read_skills = function($dir, $source) {
    $out = [];
    foreach (glob("$dir/*.md") ?: [] as $f) {
        $content = @file_get_contents($f);
        if ($content === false) continue;
        $name = basename($f, '.md');
        $desc = '';
        if (preg_match('/^---\s*\n(.*?)\n---/s', $content, $m)) {
            if (preg_match('/^name:\s*(.+)$/m', $m[1], $nm)) $name = trim($nm[1]);
            if (preg_match('/^description:\s*(.+)$/m', $m[1], $dm)) $desc = trim($dm[1]);
        }
        $out[] = ['name' => $name, 'description' => $desc, 'source' => $source, 'file' => $f, 'mtime' => filemtime($f)];
    }
    return $out;
};

$skills = array_merge(
    $ua_read_skills("$skillsBase/defaults", 'default'),
    $ua_read_skills("$skillsBase/custom", 'custom')
);
// custom wins on name collisions
$seen = [];
$mergedSkills = [];
foreach ($skills as $sk) {
    if (isset($seen[$sk['name']])) {
        if ($sk['source'] === 'custom') $mergedSkills[$seen[$sk['name']]] = $sk;
        continue;
    }
    $seen[$sk['name']] = count($mergedSkills);
    $mergedSkills[] = $sk;
}
usort($mergedSkills, fn($a, $b) => strcasecmp($a['name'], $b['name']));

// Read memory entries grouped by scope
$memoryByScope = [];
foreach (glob("$memoryBase/*", GLOB_ONLYDIR) ?: [] as $scopeDir) {
    $scope = basename($scopeDir);
    foreach (glob("$scopeDir/*.md") ?: [] as $f) {
        $memoryByScope[$scope][] = ['name' => basename($f, '.md'), 'file' => $f, 'mtime' => filemtime($f)];
    }
}
ksort($memoryByScope);
foreach ($memoryByScope as &$list) {
    usort($list, fn($a, $b) => strcasecmp($a['name'], $b['name']));
}
unset($list);
?>
