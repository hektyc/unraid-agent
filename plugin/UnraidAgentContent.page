Title="Agent Content"
Tag="fa-graduation-cap"
---
<?php
include "/usr/local/emhttp/plugins/unraid-agent/php/common.php";

$skillsBase = "/boot/config/plugins/$plugin/skills";
$memoryBase = "/boot/config/plugins/$plugin/memory";

// Read skills from defaults + custom dirs (flash is ground truth; the daemon
// syncs the embedded pack into defaults/ at startup)
$ua_read_skills = function($dir, $source) {
    $out = [];
    foreach (glob("$dir/*.md") ?: [] as $f) {
        $content = @file_get_contents($f);
        if ($content === false) continue;
        $name = basename($f, '.md');
        $desc = '';
        if (preg_match('/^---\s*\n(.*?)\n---/s', $content, $m)) {
            if (preg_match('/^name:\s*(.+)$/m', $m[1], $nm)) $name = trim($nm[1]);
            if (preg_match('/^description:\s*(.+)$/m', $m[1], $dm)) $desc = trim($dm[1]);
        }
        $out[] = ['name' => $name, 'description' => $desc, 'source' => $source, 'file' => $f, 'mtime' => filemtime($f)];
    }
    return $out;
};

$skills = array_merge(
    $ua_read_skills("$skillsBase/defaults", 'default'),
    $ua_read_skills("$skillsBase/custom", 'custom')
);
// custom wins on name collisions
$seen = [];
$mergedSkills = [];
foreach ($skills as $sk) {
    if (isset($seen[$sk['name']])) {
        if ($sk['source'] === 'custom') $mergedSkills[$seen[$sk['name']]] = $sk;
        continue;
    }
    $seen[$sk['name']] = count($mergedSkills);
    $mergedSkills[] = $sk;
}
usort($mergedSkills, fn($a, $b) => strcasecmp($a['name'], $b['name']));

// Read memory entries grouped by scope
$memoryByScope = [];
foreach (glob("$memoryBase/*", GLOB_ONLYDIR) ?: [] as $scopeDir) {
    $scope = basename($scopeDir);
    foreach (glob("$scopeDir/*.md") ?: [] as $f) {
        $memoryByScope[$scope][] = ['name' => basename($f, '.md'), 'file' => $f, 'mtime' => filemtime($f)];
    }
}
ksort($memoryByScope);
foreach ($memoryByScope as &$list) {
    usort($list, fn($a, $b) => strcasecmp($a['name'], $b['name']));
}
unset($list);
?>

<div class="ua-subtabs">
  <div class="ua-subtab active" data-uatab="skills"><i class="fa fa-graduation-cap" style="color:#ff8c2f;"></i> Agent Skills</div>
  <div class="ua-subtab" data-uatab="memory"><i class="fa fa-database" style="color:#4a90d9;"></i> Agent Memory</div>
</div>

<div class="ac-pane active" data-uatab="skills">
<blockquote class="inline_help">
Playbooks the agent can fetch via skills_list/skills_get (also exposed as MCP resources
at unraid-agent://skills/*). Default skills ship with the plugin and refresh on update;
custom skills are yours. Export any skill as SKILL.md for direct install into your IDE's
skills folder.
</blockquote>

<div class="ac-toolbar"><button type="button" class="ac-btn-new" id="ac-new-skill">+ New Skill</button></div>

<div class="ua-grid">
<?php foreach ($mergedSkills as $sk): ?>
  <div class="ua-card ac-skill-card"
       data-name="<?=htmlspecialchars($sk['name'])?>"
       data-source="<?=$sk['source']?>"
       data-file="<?=htmlspecialchars($sk['file'])?>">
    <div class="ua-card-top">
      <i class="fa fa-graduation-cap ua-card-icon-fa" style="color:#ff8c2f;"></i>
      <span class="ac-badge ac-badge-<?=$sk['source']?>"><?=$sk['source'] === 'default' ? 'Default' : 'Custom'?></span>
    </div>
    <div class="ua-card-name"><?=htmlspecialchars($sk['name'])?></div>
    <div class="ua-card-image"><?=htmlspecialchars(mb_strimwidth($sk['description'], 0, 90, '…'))?></div>
    <div class="ua-card-status"><?=$sk['mtime'] ? date('Y-m-d H:i', $sk['mtime']) : ''?></div>
    <div class="ua-card-chips">
      <span class="ua-chip ua-chip-global ac-export" data-kind="skill" data-name="<?=htmlspecialchars($sk['name'])?>" data-source="<?=htmlspecialchars($sk['source'] === 'default' ? 'defaults' : 'custom')?>" title="Download as SKILL.md">Export</span>
    </div>
  </div>
<?php endforeach; ?>
<?php if (empty($mergedSkills)): ?>
  <p><em>No skills found — start the MCP server once so it syncs the default pack, then reload this page.</em></p>
<?php endif; ?>
</div>
</div>

<div class="ac-pane" data-uatab="memory">
<blockquote class="inline_help">
Facts and notes agents can read via memory_list/memory_get. Each connected client gets
its own scope; the defaults scope holds the auto-generated server profile. Writes from
agents require Allow Memory Write in Permissions → System.
</blockquote>

<div class="ac-toolbar"><button type="button" class="ac-btn-new" id="ac-new-memory">+ New Memory</button></div>

<?php foreach ($memoryByScope as $scope => $entries): ?>
<div class="ac-scope">
  <div class="ac-scope-title"><i class="fa fa-database" style="color:#4a90d9;"></i> <?=htmlspecialchars($scope)?></div>
  <div class="ua-grid">
  <?php foreach ($entries as $m): ?>
    <div class="ua-card ac-memory-card" data-scope="<?=htmlspecialchars($scope)?>" data-name="<?=htmlspecialchars($m['name'])?>" data-file="<?=htmlspecialchars($m['file'])?>">
      <div class="ua-card-top">
        <i class="fa fa-sticky-note ua-card-icon-fa" style="color:#4a90d9;"></i>
        <span class="ua-dot" style="background:#4a90d9;"></span>
      </div>
      <div class="ua-card-name"><?=htmlspecialchars($m['name'])?></div>
      <div class="ua-card-status"><?=$m['mtime'] ? date('Y-m-d H:i', $m['mtime']) : ''?></div>
      <div class="ua-card-chips">
        <span class="ua-chip ua-chip-global"><?=htmlspecialchars($scope)?></span>
        <span class="ua-chip ua-chip-global ac-export" data-kind="memory" data-name="<?=htmlspecialchars($m['name'])?>" data-scope="<?=htmlspecialchars($scope)?>" title="Download as markdown">Export</span>
      </div>
    </div>
  <?php endforeach; ?>
  </div>
</div>
<?php endforeach; ?>
<?php if (empty($memoryByScope)): ?>
  <p><em>No memory entries yet — the server profile is generated on first daemon start, and agents can write their own once Allow Memory Write is enabled.</em></p>
<?php endif; ?>
</div>

<div class="ua-modal-overlay" id="ac-modal" style="display:none;">
  <div class="ac-modal ua-modal" style="width:720px;">
    <div class="ua-modal-head">
      <i class="fa fa-graduation-cap" style="font-size:34px;color:#ff8c2f;" id="ac-modal-icon"></i>
      <span class="ua-modal-name" id="ac-modal-title">Edit</span>
    </div>
    <div class="ac-field" id="ac-field-name">
      <label>Name (lowercase letters, digits, hyphens)</label>
      <input type="text" class="ac-name-input" id="ac-name">
    </div>
    <div class="ac-field" id="ac-field-desc">
      <label>Description (what it does and when to use it — the trigger text)</label>
      <input type="text" class="ac-desc-input" id="ac-desc">
    </div>
    <div class="ac-field">
      <label>Content (Markdown)</label>
      <textarea id="ac-content" rows="16"></textarea>
    </div>
    <div class="ua-modal-err" id="ac-err"></div>
    <div class="ua-modal-foot">
      <button type="button" class="ua-btn" id="ac-delete" style="border-color:#e74c3c;color:#e74c3c;">Delete</button>
      <button type="button" class="ua-btn" id="ac-cancel">Cancel</button>
      <button type="button" class="ua-btn ua-btn-primary" id="ac-save">Save</button>
    </div>
  </div>
</div>


