<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name		"unraid-mcp">
<!ENTITY author		"hektyc">
<!ENTITY version	"0.0.11">
<!ENTITY gitURL		"https://raw.githubusercontent.com/hektyc/unraid-mcp-server/main">
<!ENTITY pluginURL	"&gitURL;/plugin/unraid-mcp.plg">
<!ENTITY releaseURL	"https://github.com/hektyc/unraid-mcp-server/releases/latest/download">
]>

<PLUGIN name="&name;"
		author="&author;"
		version="&version;"
		pluginURL="&pluginURL;"
		icon="fa-robot"
		min="6.12.0">

<DESCRIPTION>Feature-rich MCP server for Unraid with safety controls and AI agent integration</DESCRIPTION>
<CHANGES>
###2026.07.31
- Initial release of the Go-based Unraid MCP Server plugin.
- Default read-only mode with per-function toggles.
- Supports stdio and streamable-http transport modes.
- WebGUI settings page for configuration.
</CHANGES>

<!-- Pre-install: create directories and clean old files -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

mkdir -p "$INSTALL_DIR" "$CONFIG_DIR" "$INSTALL_DIR/bin" "$INSTALL_DIR/scripts" "$INSTALL_DIR/webgui" "$INSTALL_DIR/memory"
rm -rf /usr/local/emhttp/plugins/${PLUGIN_NAME}/* 2>/dev/null
echo "Pre-install complete for ${PLUGIN_NAME}"
</INLINE>
</FILE>

<!-- Download and extract plugin package -->
<FILE Run="/bin/bash">
<INLINE>
set -e
PKG_URL="&releaseURL;/&name;.tar.gz"
TMP_FILE="/tmp/&name;.tar.gz"
echo "Downloading package from $PKG_URL ..."
curl -fsSL "$PKG_URL" -o "$TMP_FILE" || { echo "ERROR: Download failed"; rm -f "$TMP_FILE"; exit 1; }
if [ ! -s "$TMP_FILE" ]; then
  echo "ERROR: Downloaded file is empty"
  rm -f "$TMP_FILE"
  exit 1
fi
echo "Extracting package ..."
/bin/tar -xzf "$TMP_FILE" -C / || { echo "ERROR: Extraction failed"; ls -la "$TMP_FILE"; rm -f "$TMP_FILE"; exit 1; }
rm -f "$TMP_FILE"
echo "Package extracted successfully."
</INLINE>
</FILE>

<!-- Post-install: set permissions -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

chmod +x "$INSTALL_DIR/bin/unraid-mcp" "$INSTALL_DIR/scripts/"*.sh 2>/dev/null
chmod 600 "$CONFIG_DIR/config.cfg" 2>/dev/null

echo "-----------------------------------------------------------"
echo " &name; v&version; installed successfully."
echo " Configure at: Settings > Plugins > Unraid MCP Server"
echo " Set UNRAID_API_KEY in: $CONFIG_DIR/config.cfg"
echo " Start the daemon: $INSTALL_DIR/scripts/start.sh"
echo "-----------------------------------------------------------"
</INLINE>
</FILE>

<!-- Remove plugin -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
    PID=$(cat "$PIDFILE")
    kill "$PID" 2>/dev/null
    sleep 1
    kill -9 "$PID" 2>/dev/null
    rm -f "$PIDFILE"
fi

rm -rf "$INSTALL_DIR"
rm -rf "$CONFIG_DIR"

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been uninstalled."
echo "-----------------------------------------------------------"
</INLINE>
</FILE>

</PLUGIN>
