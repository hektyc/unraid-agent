<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name		"unraid-mcp">
<!ENTITY author		"hektyc">
<!ENTITY version	"0.0.27">
<!ENTITY gitURL		"https://cdn.jsdelivr.net/gh/hektyc/unraid-mcp-server@main">
<!ENTITY pluginURL	"&gitURL;/plugin/unraid-mcp.plg">
<!ENTITY releaseURL	"https://github.com/hektyc/unraid-mcp-server/releases/latest/download">
<!ENTITY pluginLOC	"/boot/config/plugins/&name;">
<!ENTITY emhttpLOC	"/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
		author="&author;"
		version="&version;"
		pluginURL="&pluginURL;"
		icon="robot"
		launch="Settings/&name;"
		min="6.12.0"
		support="https://github.com/hektyc/unraid-mcp-server/issues"
		project="https://github.com/hektyc/unraid-mcp-server">

<DESCRIPTION>Feature-rich MCP server for Unraid with safety controls and AI agent integration</DESCRIPTION>
<CHANGES>
### 0.0.15
- Fixed package extraction robustness with multiple fallback methods
- Settings page now uses standard Unraid page format
- Config moved to standard naming: unraid-mcp.cfg
- Default config file included for parse_plugin_cfg()
</CHANGES>

<!-- Pre-install: create directories and clean old files -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

mkdir -p "$INSTALL_DIR" "$CONFIG_DIR" "$INSTALL_DIR/bin" "$INSTALL_DIR/scripts" "$INSTALL_DIR/webgui" "$INSTALL_DIR/memory"
rm -rf "$INSTALL_DIR"/* 2>/dev/null
echo "Pre-install complete for ${PLUGIN_NAME}"
</INLINE>
</FILE>

<!-- Download and extract plugin package -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PKG_URL="&releaseURL;/&name;.tar"
TMP_FILE="/tmp/&name;.tar"

# Check for local package first (manual install support)
if [ -f "$CONFIG_DIR/${PLUGIN_NAME}.tar" ]; then
  echo "Using local package file"
  TMP_FILE="$CONFIG_DIR/${PLUGIN_NAME}.tar"
else
  echo "Downloading package from $PKG_URL ..."
  curl -fsSL "$PKG_URL" -o "$TMP_FILE"
  CURL_EXIT=$?
  if [ $CURL_EXIT -ne 0 ] || [ ! -s "$TMP_FILE" ]; then
    echo "ERROR: Download failed (curl exit: $CURL_EXIT)"
    echo "If the repo is private, download unraid-mcp.plg and unraid-mcp.tar manually"
    echo "from the release page and SCP them to this server."
    rm -f "$TMP_FILE"
    exit 1
  fi
fi

echo "Extracting package ..."
echo "File size: $(stat -c%s "$TMP_FILE" 2>&amp;1 || stat -f%z "$TMP_FILE" 2>&amp;1) bytes"
echo "File type: $(file "$TMP_FILE" 2>&amp;1 || echo 'unknown')"
echo "tar version: $(tar --version 2>&amp;1 | head -1 || echo 'unknown')"
echo "Disk space on /: $(df -h / | tail -1)"
echo "Disk space on /boot: $(df -h /boot | tail -1)"
echo "Temp file path: $TMP_FILE"
echo "---"

# Primary extraction: use --no-same-owner to avoid uid/gid conflicts from CI
echo "Extracting with tar --no-same-owner -xf ..."
TAR_ERR=$(tar --no-same-owner -xf "$TMP_FILE" -C / 2>&amp;1)
TAR_EXIT=$?
if [ $TAR_EXIT -eq 0 ]; then
  echo "Extraction succeeded"
  rm -f "$TMP_FILE"
  echo "Package extracted successfully."
  exit 0
fi
echo "Primary extraction failed (exit $TAR_EXIT):"
echo "$TAR_ERR"
echo "---"

# Fallback: extract to temp dir first, then copy individual files
echo "Fallback: extracting to temp dir and copying files..."
EXTRACT_DIR="/tmp/${PLUGIN_NAME}-extract"
rm -rf "$EXTRACT_DIR"
mkdir -p "$EXTRACT_DIR"
TAR_ERR=$(tar --no-same-owner --keep-going -xf "$TMP_FILE" -C "$EXTRACT_DIR" 2>&amp;1)
if [ $? -ne 0 ] &amp;&amp; [ ! -d "$EXTRACT_DIR" ]; then
  echo "Fallback tar extraction also failed: $TAR_ERR"
  rm -f "$TMP_FILE"
  rm -rf "$EXTRACT_DIR"
  exit 1
fi

# Copy files individually to / from EXTRACT_DIR
cd "$EXTRACT_DIR"
copy_ok=0
copy_fail=0
for f in $(find . -type f 2>/dev/null); do
  dst="/$f"
  dst_dir=$(dirname "$dst")
  mkdir -p "$dst_dir" 2>/dev/null
  cp -f "$f" "$dst" 2>/dev/null
  if [ $? -eq 0 ]; then
    copy_ok=$((copy_ok + 1))
  else
    echo "  Failed to copy: $f"
    copy_fail=$((copy_fail + 1))
  fi
done

# Verify critical binary
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
if [ -f "$INSTALL_DIR/bin/unraid-mcp" ]; then
  chmod +x "$INSTALL_DIR/bin/unraid-mcp"
  echo "Binary installed at $INSTALL_DIR/bin/unraid-mcp"
  echo "Copied: $copy_ok files OK, $copy_fail failed"
  rm -f "$TMP_FILE"
  rm -rf "$EXTRACT_DIR"
  echo "Package extracted successfully (via fallback)."
  exit 0
fi

echo "ERROR: Extraction failed completely"
echo "Copied: $copy_ok files OK, $copy_fail failed"
rm -f "$TMP_FILE"
rm -rf "$EXTRACT_DIR"
exit 1
</INLINE>
</FILE>

<!-- Post-install: set permissions -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

chmod +x "$INSTALL_DIR/bin/unraid-mcp" "$INSTALL_DIR/scripts/"*.sh 2>/dev/null
chmod 600 "$CONFIG_DIR/${PLUGIN_NAME}.cfg" 2>/dev/null

echo "-----------------------------------------------------------"
echo " &name; v&version; installed successfully."
echo " Configure at: Settings > Plugins > Unraid MCP Server"
echo " Set UNRAID_API_KEY in: $CONFIG_DIR/${PLUGIN_NAME}.cfg"
echo " Start the daemon: $INSTALL_DIR/scripts/start.sh"
echo "-----------------------------------------------------------"
</INLINE>
</FILE>

<!-- Update: clean old files before re-install -->
<FILE Run="/bin/bash" Method="update">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

rm -rf "$INSTALL_DIR"/* 2>/dev/null
echo "Pre-update cleanup complete"
</INLINE>
</FILE>

<!-- Remove plugin -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

rm -rf "$INSTALL_DIR"
rm -rf "$CONFIG_DIR"

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been uninstalled."
echo "-----------------------------------------------------------"
</INLINE>
</FILE>

</PLUGIN>
