<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name		"unraid-mcp">
<!ENTITY author		"hektyc">
<!ENTITY version	"0.0.22">
<!ENTITY gitURL		"https://cdn.jsdelivr.net/gh/hektyc/unraid-mcp-server@main">
<!ENTITY pluginURL	"&gitURL;/plugin/unraid-mcp.plg">
<!ENTITY releaseURL	"https://github.com/hektyc/unraid-mcp-server/releases/latest/download">
<!ENTITY pluginLOC	"/boot/config/plugins/&name;">
<!ENTITY emhttpLOC	"/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
		author="&author;"
		version="&version;"
		pluginURL="&pluginURL;"
		icon="fa-robot"
		launch="Settings/Unraid MCP Server"
		min="6.12.0"
		support="https://github.com/hektyc/unraid-mcp-server/issues"
		project="https://github.com/hektyc/unraid-mcp-server">

<DESCRIPTION>Feature-rich MCP server for Unraid with safety controls and AI agent integration</DESCRIPTION>
<CHANGES>
### 0.0.15
- Fixed package extraction robustness with multiple fallback methods
- Settings page now uses standard Unraid page format
- Config moved to standard naming: unraid-mcp.cfg
- Default config file included for parse_plugin_cfg()
</CHANGES>

<!-- Pre-install: create directories and clean old files -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

mkdir -p "$INSTALL_DIR" "$CONFIG_DIR" "$INSTALL_DIR/bin" "$INSTALL_DIR/scripts" "$INSTALL_DIR/webgui" "$INSTALL_DIR/memory"
rm -rf "$INSTALL_DIR"/* 2>/dev/null
echo "Pre-install complete for ${PLUGIN_NAME}"
</INLINE>
</FILE>

<!-- Download and extract plugin package -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PKG_URL="&releaseURL;/&name;.tar"
TMP_FILE="/tmp/&name;.tar"

# Check for local package first (manual install support)
if [ -f "$CONFIG_DIR/${PLUGIN_NAME}.tar" ]; then
  echo "Using local package file"
  TMP_FILE="$CONFIG_DIR/${PLUGIN_NAME}.tar"
else
  echo "Downloading package from $PKG_URL ..."
  curl -fsSL "$PKG_URL" -o "$TMP_FILE"
  CURL_EXIT=$?
  if [ $CURL_EXIT -ne 0 ] || [ ! -s "$TMP_FILE" ]; then
    echo "ERROR: Download failed (curl exit: $CURL_EXIT)"
    echo "If the repo is private, download unraid-mcp.plg and unraid-mcp.tar manually"
    echo "from the release page and SCP them to this server."
    rm -f "$TMP_FILE"
    exit 1
  fi
fi

echo "Extracting package ..."
echo "File size: $(stat -c%s "$TMP_FILE" 2>&amp;1 || stat -f%z "$TMP_FILE" 2>&amp;1) bytes"
echo "File type: $(file "$TMP_FILE" 2>&amp;1 || echo 'unknown')"
echo "tar version: $(tar --version 2>&amp;1 | head -1 || echo 'unknown')"
echo "Disk space on /: $(df -h / | tail -1)"
echo "Disk space on /boot: $(df -h /boot | tail -1)"
echo "Temp file path: $TMP_FILE"
echo "---"

# Method 1: standard tar extraction with verbose error capture
echo "Method 1: tar -xf \"$TMP_FILE\" -C /"
TAR_ERR=$(tar -xf "$TMP_FILE" -C / 2>&amp;1)
TAR_EXIT=$?
if [ $TAR_EXIT -eq 0 ]; then
  echo "Extraction method 1 (tar -xf -C) succeeded"
  rm -f "$TMP_FILE"
  echo "Package extracted successfully."
  exit 0
fi
echo "Method 1 exit code: $TAR_EXIT"
echo "Method 1 stderr stdout: $TAR_ERR"

# Method 2: cd to root first
echo "Method 2: cd / &amp;&amp; tar -xf \"$TMP_FILE\""
cd /
TAR_ERR=$(tar -xf "$TMP_FILE" 2>&amp;1)
TAR_EXIT=$?
if [ $TAR_EXIT -eq 0 ]; then
  echo "Extraction method 2 succeeded"
  rm -f "$TMP_FILE"
  echo "Package extracted successfully."
  exit 0
fi
echo "Method 2 exit code: $TAR_EXIT"
echo "Method 2 stderr stdout: $TAR_ERR"

# Method 3: extract via stdin
echo "Method 3: cat \"$TMP_FILE\" | tar -xf -"
cd /
TAR_ERR=$(cat "$TMP_FILE" | tar -xf - 2>&amp;1)
TAR_EXIT=$?
if [ $TAR_EXIT -eq 0 ]; then
  echo "Extraction method 3 succeeded"
  rm -f "$TMP_FILE"
  echo "Package extracted successfully."
  exit 0
fi
echo "Method 3 exit code: $TAR_EXIT"
echo "Method 3 stderr stdout: $TAR_ERR"

echo "ERROR: All extraction methods failed"
echo "---"
echo "Diagnostic information:"
echo "File: $(ls -la "$TMP_FILE" 2>&amp;1)"
echo "File content start: $(head -c 50 "$TMP_FILE" | xxd | head -1 2>&amp;1)"
echo "Writable targets:"
echo "  /usr/local/emhttp/plugins/ : $(test -w /usr/local/emhttp/plugins/ &amp;&amp; echo "YES" || echo "NO")"
echo "  /boot/config/plugins/ : $(test -w /boot/config/plugins/ &amp;&amp; echo "YES" || echo "NO")"

# Method 4: Extract to temp dir, then copy individually
echo "---"
echo "Method 4: Extract to temp dir &amp;&amp; copy files individually"
EXTRACT_DIR="/tmp/${PLUGIN_NAME}-extract"
rm -rf "$EXTRACT_DIR"
mkdir -p "$EXTRACT_DIR"
TAR_ERR=$(tar -xf "$TMP_FILE" -C "$EXTRACT_DIR" 2>&amp;1)
TAR_EXIT=$?
if [ $TAR_EXIT -ne 0 ]; then
  echo "Method 4 tar extract to temp failed: $TAR_ERR"
  echo "Trying with --keep-going..."
  TAR_ERR=$(tar --keep-going -xf "$TMP_FILE" -C "$EXTRACT_DIR" 2>&amp;1)
  TAR_EXIT=$?
  if [ $TAR_EXIT -ne 0 ]; then
    echo "Method 4 with --keep-going also failed"
  fi
fi

if [ -d "$EXTRACT_DIR" ]; then
  echo "Extracting files from temp dir..."
  INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
  CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
  mkdir -p "$INSTALL_DIR/bin" "$INSTALL_DIR/scripts" "$INSTALL_DIR/webgui" "$INSTALL_DIR/memory" "$CONFIG_DIR"
  
  copy_ok=0
  copy_fail=0
  
  # Copy all files, continuing despite errors
  cd "$EXTRACT_DIR"
  for f in $(find . -type f 2>&amp;1); do
    src="$EXTRACT_DIR/$f"
    dst="/$f"
    dst_dir=$(dirname "$dst")
    mkdir -p "$dst_dir" 2>/dev/null
    cp -f "$src" "$dst" 2>/dev/null
    if [ $? -eq 0 ]; then
      copy_ok=$((copy_ok + 1))
    else
      echo "  Failed to copy: $f"
      copy_fail=$((copy_fail + 1))
    fi
  done
  
  echo "Copied: $copy_ok files OK, $copy_fail failed"
  
  # Verify critical file
  if [ -f "$INSTALL_DIR/bin/unraid-mcp" ]; then
    echo "Binary OK at $INSTALL_DIR/bin/unraid-mcp"
    chmod +x "$INSTALL_DIR/bin/unraid-mcp"
    rm -f "$TMP_FILE"
    rm -rf "$EXTRACT_DIR"
    echo "Package extracted successfully (partial extraction)."
    echo "WARNING: $copy_fail files failed to copy - check /boot/ filesystem health."
    exit 0
  fi
fi

echo "ERROR: All extraction methods failed including fallback"
rm -f "$TMP_FILE"
rm -rf "$EXTRACT_DIR"
exit 1
</INLINE>
</FILE>

<!-- Post-install: set permissions -->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

chmod +x "$INSTALL_DIR/bin/unraid-mcp" "$INSTALL_DIR/scripts/"*.sh 2>/dev/null
chmod 600 "$CONFIG_DIR/${PLUGIN_NAME}.cfg" 2>/dev/null

echo "-----------------------------------------------------------"
echo " &name; v&version; installed successfully."
echo " Configure at: Settings > Plugins > Unraid MCP Server"
echo " Set UNRAID_API_KEY in: $CONFIG_DIR/${PLUGIN_NAME}.cfg"
echo " Start the daemon: $INSTALL_DIR/scripts/start.sh"
echo "-----------------------------------------------------------"
</INLINE>
</FILE>

<!-- Update: clean old files before re-install -->
<FILE Run="/bin/bash" Method="update">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

rm -rf "$INSTALL_DIR"/* 2>/dev/null
echo "Pre-update cleanup complete"
</INLINE>
</FILE>

<!-- Remove plugin -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
PLUGIN_NAME="&name;"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

rm -rf "$INSTALL_DIR"
rm -rf "$CONFIG_DIR"

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been uninstalled."
echo "-----------------------------------------------------------"
</INLINE>
</FILE>

</PLUGIN>
