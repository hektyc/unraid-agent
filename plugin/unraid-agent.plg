<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
    <!ENTITY name        "unraid-agent">
    <!ENTITY author      "hektyc">
    <!ENTITY version     "0.0.39">
    <!ENTITY gitURL      "https://raw.githubusercontent.com/hektyc/unraid-agent/main">
    <!ENTITY pluginURL   "&gitURL;/plugin/unraid-agent.plg">
    <!ENTITY releaseURL  "https://github.com/hektyc/unraid-agent/releases/latest/download">
    <!ENTITY pluginLOC    "/boot/config/plugins/&name;">
    <!ENTITY emhttpLOC    "/usr/local/emhttp/plugins/&name;">
    <!ENTITY iconPath     "&emhttpLOC;/images/unraid-agent-48.png">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="Settings/&name;" icon="&iconPath;" min="6.12.0" pluginURL="&pluginURL;" support="https://github.com/hektyc/unraid-agent/issues" project="https://github.com/hektyc/unraid-agent">

<DESCRIPTION>Unraid MCP Server (named 'unraid-agent' to avoid conflicts) - Feature-rich MCP server for Unraid with safety controls and AI agent integration</DESCRIPTION>
<CHANGES>
### 0.0.37
- Added Start MCP Server and Stop MCP Server buttons to the WebGUI settings page
- Added Service Status section with RUNNING/STOPPED display and interactive buttons
- Removed symlink workaround — binary now rebuilt with correct config path

### 0.0.36
- Fix: create symlink for legacy config path so binary can find config at /boot/config/plugins/unraid-mcp/config.cfg
</CHANGES>

<!-- Pre-install: create directories, copy icons, and clean old files -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

mkdir -p "$INSTALL_DIR" "$CONFIG_DIR" "$INSTALL_DIR/bin" "$INSTALL_DIR/scripts" "$INSTALL_DIR/memory" "$INSTALL_DIR/images"
rm -rf "$INSTALL_DIR"/* 2>/dev/null
mkdir -p "$INSTALL_DIR/images"
# Clean up old plugin (unraid-mcp) files
rm -f "$CONFIG_DIR/webgui/unraid-mcp.settings.page" 2>/dev/null
rm -f "$INSTALL_DIR/webgui/unraid-mcp.settings.page" 2>/dev/null
rm -f "$CONFIG_DIR/unraid-mcp.cfg" 2>/dev/null
echo "Pre-install complete for ${PLUGIN_NAME}"
]]>
</INLINE>
</FILE>

<!-- Download and extract plugin package -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PKG_URL="https://github.com/hektyc/unraid-agent/releases/latest/download/unraid-agent.tar"
TMP_FILE="/tmp/unraid-agent.tar"

if [ -f "$CONFIG_DIR/unraid-agent.tar" ]; then
  echo "Using local package file"
  TMP_FILE="$CONFIG_DIR/unraid-agent.tar"
else
  echo "Downloading package from $PKG_URL ..."
  curl -fsSL "$PKG_URL" -o "$TMP_FILE"
  CURL_EXIT=$?
  if [ $CURL_EXIT -ne 0 ] || [ ! -s "$TMP_FILE" ]; then
    echo "ERROR: Download failed (curl exit: $CURL_EXIT)"
    rm -f "$TMP_FILE"
    exit 1
  fi
fi

echo "Extracting package ..."
echo "File size: $(stat -c%s "$TMP_FILE" 2>&1 || stat -f%z "$TMP_FILE" 2>&1) bytes"
echo "---"

echo "Extracting with tar --no-same-owner -xf ..."
tar --no-same-owner -xf "$TMP_FILE" -C / 2>&1
TAR_EXIT=$?
if [ $TAR_EXIT -eq 0 ]; then
  echo "Extraction succeeded"
  rm -f "$TMP_FILE"
  echo "Package extracted successfully."
  exit 0
fi
echo "Primary extraction failed (exit $TAR_EXIT)"
rm -f "$TMP_FILE"
exit 1
]]>
</INLINE>
</FILE>

<!-- Create default config.cfg if it does not exist -->
<FILE Name="/boot/config/plugins/&name;/config.cfg">
<INLINE>
<![CDATA[
UNRAID_API_URL=""
UNRAID_API_KEY=""
TRANSPORT="stdio"
UNRAID_MCP_HOST="127.0.0.1"
UNRAID_MCP_PORT="6970"
READ_ONLY="true"
ALLOW_ARRAY_STOP="false"
ALLOW_ARRAY_START="false"
ALLOW_ARRAY_ADD_DISK="false"
ALLOW_ARRAY_REMOVE_DISK="false"
ALLOW_ARRAY_CLEAR_STATS="false"
ALLOW_CONTAINER_STOP="false"
ALLOW_CONTAINER_REMOVE="false"
ALLOW_CONTAINER_RESTART="false"
ALLOW_VM_FORCE_STOP="false"
ALLOW_VM_RESET="false"
ALLOW_VM_STOP="false"
ALLOW_PLUGIN_INSTALL="false"
ALLOW_PLUGIN_REMOVE="false"
ALLOW_SETTING_UPDATES="false"
ALLOW_SSH_UPDATE="false"
ALLOW_TIME_UPDATE="false"
ALLOW_NOTIFICATION_DELETE="false"
ALLOW_API_KEY_CREATE="false"
ALLOW_API_KEY_DELETE="false"
ALLOW_FLASH_BACKUP="false"
ALLOW_RCLONE_OPERATIONS="false"
ALLOW_CONNECT_ACTIONS="false"
ALLOW_ONBOARDING_ACTIONS="false"
ALLOW_DOCKER_ACTIONS="false"
ALLOW_VM_ACTIONS="false"
ALLOW_ARRAY_ACTIONS="false"
ALLOW_DESTRUCTIVE="false"
UNRAID_MCP_LOG_LEVEL="info"
UNRAID_VERIFY_SSL="true"
UNRAID_ALLOW_INSECURE_TLS="false"
UNRAID_MCP_BEARER_TOKEN=""
UNRAID_MCP_DISABLE_HTTP_AUTH="false"
]]>
</INLINE>
</FILE>

<!-- Post-install: set permissions and print summary -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

chmod +x "$INSTALL_DIR/bin/unraid-mcp" "$INSTALL_DIR/scripts/"*.sh 2>/dev/null
chmod 644 "$INSTALL_DIR/images/"*.png 2>/dev/null
chmod 600 "$CONFIG_DIR/config.cfg" 2>/dev/null

echo "-----------------------------------------------------------"
echo " ${PLUGIN_NAME} v0.0.34 installed successfully."
echo " Settings: Settings → User Utilities → Unraid Agent"
echo " Set UNRAID_API_KEY in: $CONFIG_DIR/config.cfg"
echo " Start daemon: $INSTALL_DIR/scripts/start.sh"
echo "-----------------------------------------------------------"
echo ""
echo "*** RESTART THE WEBGUI TO REGISTER THE SETTINGS PAGE ***"
echo "Try one of these commands in SSH:"
echo "  /usr/local/emhttp/emhttp -r"
echo "  kill -HUP \$(pidof emhttp)"
echo "Or use WebUI: Settings → Management Access → Restart WebGUI"
echo "Then hard refresh browser (Ctrl+F5)"
]]>
</INLINE>
</FILE>

<!-- Update: stop service and clean old files before re-install -->
<FILE Run="/bin/bash" Method="update">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

rm -rf "/usr/local/emhttp/plugins/${PLUGIN_NAME}"/* 2>/dev/null
echo "Pre-update cleanup complete"
]]>
</INLINE>
</FILE>

<!-- Remove plugin -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

rm -rf "$INSTALL_DIR"
rm -rf "$CONFIG_DIR"

echo ""
echo "-----------------------------------------------------------"
echo " ${PLUGIN_NAME} has been uninstalled."
echo "-----------------------------------------------------------"
]]>
</INLINE>
</FILE>

</PLUGIN>
