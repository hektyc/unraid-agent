<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
    <!ENTITY name        "unraid-agent">
    <!ENTITY author      "hektyc">
    <!ENTITY version     "2026.08.16.0249">
    <!ENTITY gitURL      "https://raw.githubusercontent.com/hektyc/unraid-agent/main">
    <!ENTITY pluginURL   "&gitURL;/plugin/unraid-agent.plg">
    <!ENTITY releaseURL  "https://github.com/hektyc/unraid-agent/releases/latest/download">
    <!ENTITY pluginLOC    "/boot/config/plugins/&name;">
    <!ENTITY emhttpLOC    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="Settings/&name;" min="6.12.0" pluginURL="&pluginURL;" support="https://github.com/hektyc/unraid-agent/issues" project="https://github.com/hektyc/unraid-agent">

<DESCRIPTION>Unraid MCP Server (named 'unraid-agent' to avoid conflicts) - Feature-rich MCP server for Unraid with safety controls and AI agent integration</DESCRIPTION>
<CHANGES>
### 2026.08.02.2304
- Fix: download/verify-then-clear install flow prevents plugin disappearance on failed updates
- Fix: variable naming consistency in download error handling ($TMP_FILE)
- Fix: post-install version now reads actual version from .plg entity instead of hardcoded v0.0.34
- Added: post-extraction verification of critical files (page file, binary, PHP scripts)
- Added: install.sh config defaults synced with current config.cfg
</CHANGES>

 <!-- Pre-install: create directories and clean legacy files only (do NOT clear yet) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

mkdir -p "$INSTALL_DIR" "$CONFIG_DIR" "$INSTALL_DIR/bin" "$INSTALL_DIR/scripts" "$INSTALL_DIR/memory" "$INSTALL_DIR/images" "$INSTALL_DIR/php" "$INSTALL_DIR/icons"
# Clean up old/legacy files from prior versions
rm -f "$CONFIG_DIR/webgui/unraid-agent.settings.page" 2>/dev/null
rm -f "$INSTALL_DIR/webgui/unraid-agent.settings.page" 2>/dev/null
rm -f "$CONFIG_DIR/unraid-agent.cfg" 2>/dev/null
echo "Pre-install complete for ${PLUGIN_NAME}"
]]>
</INLINE>
</FILE>

<!-- Download, verify, then clear and extract plugin package -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PKG_URL="https://github.com/hektyc/unraid-agent/releases/latest/download/unraid-agent.tar"
PKG_TMP="/tmp/unraid-agent.tar"

# Try local package first, then download
if [ -f "$CONFIG_DIR/unraid-agent.tar" ]; then
  echo "Using local package file"
  PKG_TMP="$CONFIG_DIR/unraid-agent.tar"
else
  echo "Downloading package from $PKG_URL ..."
  curl -fsSL "$PKG_URL" -o "$PKG_TMP"
  CURL_EXIT=$?
  if [ "$CURL_EXIT" -ne 0 ] || [ ! -s "$PKG_TMP" ]; then
    echo "ERROR: Download failed (curl exit: $CURL_EXIT)"
    rm -f "$PKG_TMP"
    exit 1
  fi
fi

echo "Package size: $(stat -c%s "$PKG_TMP" 2>&1 || stat -f%z "$PKG_TMP" 2>&1) bytes"
echo "---"

# Verify the tarball is valid before clearing anything
echo "Verifying tarball integrity..."
if ! tar -tf "$PKG_TMP" >/dev/null 2>&1; then
  echo "ERROR: Tarball is corrupt or not a valid tar archive"
  rm -f "$PKG_TMP"
  exit 1
fi

# Download/verify succeeded — now safe to clear old install files
echo "Clearing old installation files..."
rm -rf "${INSTALL_DIR:?}/"* 2>/dev/null || true

# Extract the package
echo "Extracting package..."
tar --no-same-owner -xf "$PKG_TMP" -C / 2>&1
TAR_EXIT=$?
rm -f "$PKG_TMP"

if [ "$TAR_EXIT" -ne 0 ]; then
  echo "ERROR: Extraction failed (tar exit: $TAR_EXIT)"
  exit 1
fi

# Verify critical files were extracted
MISSING=0
for f in \
  "$INSTALL_DIR/unraid-agent.page" \
  "$INSTALL_DIR/bin/unraid-agent" \
  "$INSTALL_DIR/php/common.php" \
  "$INSTALL_DIR/scripts/start.sh" \
  "$INSTALL_DIR/scripts/stop.sh" \
  "$INSTALL_DIR/css/ua-style.css" \
  "$INSTALL_DIR/js/ua-script.js"; do
  if [ ! -e "$f" ]; then
    echo "WARNING: Expected file missing after extraction: $f"
    MISSING=$((MISSING + 1))
  fi
done

if [ "$MISSING" -gt 0 ]; then
  echo "ERROR: $MISSING critical file(s) missing after extraction — plugin may be broken"
  exit 1
fi

echo "Package extracted and verified successfully."
exit 0
]]>
</INLINE>
</FILE>

<!-- Create default config.cfg ONLY if it does not exist (survives updates) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"

if [ ! -f "$CONFIG_DIR/config.cfg" ]; then
  mkdir -p "$CONFIG_DIR"
  if [ -f "$INSTALL_DIR/default.cfg" ]; then
    cp "$INSTALL_DIR/default.cfg" "$CONFIG_DIR/config.cfg"
  else
    echo "WARNING: default.cfg not found — config.cfg not created"
  fi
  chmod 600 "$CONFIG_DIR/config.cfg" 2>/dev/null || true
  echo "Created default config.cfg"
else
  echo "Existing config.cfg preserved"
fi
]]>
</INLINE>
</FILE>

<!-- Post-install: set permissions and print summary -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"

VERSION=$(grep '<!ENTITY version' "$CONFIG_DIR/unraid-agent.plg" 2>/dev/null | grep -o '"[^"]*"' | tail -1 | tr -d '"')
if [ -z "$VERSION" ]; then
  VERSION=$(grep '<!ENTITY version' "$INSTALL_DIR/unraid-agent.plg" 2>/dev/null | grep -o '"[^"]*"' | tail -1 | tr -d '"')
fi

chmod +x "$INSTALL_DIR/bin/unraid-agent" "$INSTALL_DIR/scripts/"*.sh 2>/dev/null
chmod 644 "$INSTALL_DIR/images/"*.png "$INSTALL_DIR/icons/"*.png "$INSTALL_DIR/unraid-agent.png" 2>/dev/null

echo "-----------------------------------------------------------"
echo " ${PLUGIN_NAME} v${VERSION} installed successfully."
echo " Settings: Settings → User Utilities → Unraid Agent"
echo " Set UNRAID_API_KEY in: $CONFIG_DIR/config.cfg"
echo " Start daemon: $INSTALL_DIR/scripts/start.sh"
echo "-----------------------------------------------------------"
]]>
</INLINE>
</FILE>

<!-- Update: stop service before re-install (extraction clears old files) -->
<FILE Run="/bin/bash" Method="update">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

echo "Pre-update cleanup complete"
]]>
</INLINE>
</FILE>

<!-- Remove plugin -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_NAME="unraid-agent"
INSTALL_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"
CONFIG_DIR="/boot/config/plugins/${PLUGIN_NAME}"
PIDFILE="$CONFIG_DIR/server.pid"

if [ -f "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  kill "$PID" 2>/dev/null
  sleep 1
  kill -9 "$PID" 2>/dev/null
  rm -f "$PIDFILE"
fi

rm -rf "$INSTALL_DIR"
rm -rf "$CONFIG_DIR"

echo ""
echo "-----------------------------------------------------------"
echo " ${PLUGIN_NAME} has been uninstalled."
echo "-----------------------------------------------------------"
]]>
</INLINE>
</FILE>

</PLUGIN>
